# Career applications use direct email links and require no server-side secrets.

# Optional search and social platform ownership verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
YAHOO_SITE_VERIFICATION=
PINTEREST_SITE_VERIFICATION=
FACEBOOK_DOMAIN_VERIFICATION=

# Contact Us notifications (server-only; authorized Resend account + verified domain).
RESEND_CONTACT_API_KEY=
# A plain sender email on the verified Resend domain; never the visitor's email.
RESEND_FROM=
# Cloudflare Turnstile: use a production widget restricted to the site's hostnames.
TURNSTILE_SECRET_KEY=
# Public widget identifier only. This is NOT a secret; required at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
